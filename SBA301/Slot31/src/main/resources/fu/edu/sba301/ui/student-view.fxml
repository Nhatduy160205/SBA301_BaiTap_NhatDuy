<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fu.edu.sba301.ui.controller.StudentController"
            prefWidth="800.0" prefHeight="600.0">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>
    <top>
        <VBox alignment="CENTER" spacing="10">
            <Label text="Student Management" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="15">
            <BorderPane.margin>
                <Insets top="10" bottom="10"/>
            </BorderPane.margin>
            <GridPane hgap="10" vgap="8">
                <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEmail" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="First name:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtFirstName" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="Last name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtLastName" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

                <Label text="Marks:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtMarks" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnCreate" text="Create" onAction="#handleCreate" style="-fx-base: #28a745;"/>
                <Button fx:id="btnUpdate" text="Update" onAction="#handleUpdate" style="-fx-base: #ffc107;"/>
                <Button fx:id="btnDelete" text="Delete" onAction="#handleDelete" style="-fx-base: #dc3545;"/>
                <Button fx:id="btnClear" text="Clear" onAction="#handleClear"/>
                <Button fx:id="btnRefresh" text="Refresh" onAction="#handleRefresh"/>
            </HBox>

            <TableView fx:id="tblStudents" VBox.vgrow="ALWAYS" prefHeight="350">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="colFirstName" text="First Name" prefWidth="150"/>
                    <TableColumn fx:id="colLastName" text="Last Name" prefWidth="150"/>
                    <TableColumn fx:id="colMarks" text="Marks" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>