{
  "info": {
    "name": "FUMiniHotel REST API (Assignment 03 SBA301)",
    "description": "Collection of RESTful APIs for FUMiniHotelSystem with JWT Authentication and Role-based Access Control",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Staff Login (from application.properties)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@fuminihotel.com\",\n  \"password\": \"Staff@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@gmail.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Customer Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerFullName\": \"Le Van Test\",\n  \"telephone\": \"0988776655\",\n  \"emailAddress\": \"test.customer@gmail.com\",\n  \"customerBirthday\": \"1999-08-20\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Rooms (Public & Staff)",
      "item": [
        {
          "name": "Get All Rooms (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            }
          }
        },
        {
          "name": "Search Rooms (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/rooms/search?roomNumber=R1&maxPrice=100",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "search"],
              "query": [
                { "key": "roomNumber", "value": "R1" },
                { "key": "maxPrice", "value": "100" }
              ]
            }
          }
        },
        {
          "name": "Create Room (Staff Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"R501\",\n  \"roomDetailDescription\": \"Luxury Presidential Suite with sea view\",\n  \"roomMaxCapacity\": 4,\n  \"roomTypeID\": 3,\n  \"roomStatus\": 1,\n  \"roomPricePerDay\": 150.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            }
          }
        },
        {
          "name": "Update Room (Staff Only)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"R501\",\n  \"roomDetailDescription\": \"Updated description with breakfast included\",\n  \"roomMaxCapacity\": 4,\n  \"roomTypeID\": 3,\n  \"roomStatus\": 1,\n  \"roomPricePerDay\": 160.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/1",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "1"]
            }
          }
        },
        {
          "name": "Delete Room (Staff Only - Smart Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms/1",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customers",
      "item": [
        {
          "name": "Get Profile (Logged-in User)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/profile",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "profile"]
            }
          }
        },
        {
          "name": "Get All Customers (Staff Only)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Bookings",
      "item": [
        {
          "name": "Create Multi-Room Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingDetails\": [\n    {\n      \"roomID\": 1,\n      \"startDate\": \"2026-12-01\",\n      \"endDate\": \"2026-12-03\"\n    },\n    {\n      \"roomID\": 2,\n      \"startDate\": \"2026-12-01\",\n      \"endDate\": \"2026-12-04\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "Get My History (Customer)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/my-history",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "my-history"]
            }
          }
        },
        {
          "name": "Get All Bookings (Staff Only)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        }
      ]
    }
  ]
}

